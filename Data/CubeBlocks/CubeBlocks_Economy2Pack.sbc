            <Icon>Textures\GUI\Icons\Cubes\AngledDoorSmall.dds</Icon>
            <Description>Description_Door</Description>
            <CubeSize>Small</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="5" y="4" z="3" />
            <ModelOffset x="0" y="0" z="0" />
            <Center x="2" y="0" z="2" />
            <Model>Models\Cubes\Small\AngledDoorSmall.mwm</Model>
            <PlaceDecals>false</PlaceDecals>
            <OpenSound>BlockDoorSmallOpen</OpenSound>
            <CloseSound>BlockDoorSmallClose</CloseSound>
            <Components>
                <Component Subtype="SteelPlate" Count="10" />
                <Component Subtype="Construction" Count="15" />
                <Component Subtype="Motor" Count="2" />
                <Component Subtype="Display" Count="1" />
                <Component Subtype="Computer" Count="2" />
                <Component Subtype="Construction" Count="25" />
                <Component Subtype="SteelPlate" Count="10" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
            <MountPoints>
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="4" />
                <MountPoint Side="Front" StartX="4" StartY="0" EndX="5" EndY="4" />
                <MountPoint Side="Front" StartX="1" StartY="3.8" EndX="4" EndY="4" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="1.5" EndY="4" />
                <MountPoint Side="Left" StartX="1.5" StartY="0" EndX="2.5" EndY="3" />
                <MountPoint Side="Left" StartX="2.5" StartY="0" EndX="3" EndY="1" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="3" EndY="4" Enabled="false" PressurizedWhenOpen="false"/>
                <MountPoint Side="Right" StartX="1.5" StartY="0" EndX="3" EndY="4" />
                <MountPoint Side="Right" StartX="0.5" StartY="0" EndX="1.5" EndY="3" />
