                <MountPoint Side="Right" StartX="0" StartY="0" EndX="3" EndY="4" Enabled="false" PressurizedWhenOpen="false"/>
                <MountPoint Side="Top" StartX="0" StartY="2.7" EndX="5" EndY="3" />
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="5" EndY="3" Enabled="false" PressurizedWhenOpen="false"/>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="3" Default="true" />
                <MountPoint Side="Bottom" StartX="4" StartY="0" EndX="5" EndY="3" />
                <MountPoint Side="Bottom" StartX="1" StartY="2.8" EndX="4" EndY="3" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="5" EndY="4" Enabled="false" PressurizedWhenOpen="false"/>
