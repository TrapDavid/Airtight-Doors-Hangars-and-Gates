                <MountPoint Side="Left" StartX="0.5" StartY="0" EndX="1" EndY="0.5" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" Enabled="false" PressurizedWhenOpen="false"/>
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="0.5" />
                <MountPoint Side="Right" StartX="0.5" StartY="0.5" EndX="1" EndY="1" />
