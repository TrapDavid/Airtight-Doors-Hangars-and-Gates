                <MountPoint Side="Top" StartX="0" StartY="0.5" EndX="0.05" EndY="0.95" />
                <MountPoint Side="Top" StartX="0.95" StartY="0.5" EndX="1" EndY="0.95" />
                <MountPoint Side="Top" StartX="0" StartY="0.95" EndX="1" EndY="1" />
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" Enabled="false" PressurizedWhenOpen="false"/>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="0.05" EndY="1" />
                <MountPoint Side="Bottom" StartX="0.95" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Bottom" StartX="0.05" StartY="0" EndX="0.95" EndY="0.05" />
                <MountPoint Side="Bottom" StartX="0.05" StartY="0.95" EndX="0.95" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\AngledDoor2Construction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\AngledDoor2Construction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\AngledDoor2Construction_3.mwm" />
            </BuildProgressModels>
            <BlockPairName>AngledDoorB</BlockPairName>
            <MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>20</BuildTimeSeconds>
            <DisassembleRatio>1.5</DisassembleRatio>
            <ResourceSinkGroup>Doors</ResourceSinkGroup>
            <MaxOpen>0.885</MaxOpen>
            <OpeningSpeed>2</OpeningSpeed>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <EmissiveColorPreset>Default</EmissiveColorPreset>
            <DestroyEffect>BlockDestroyed_Large</DestroyEffect>
            <DestroySound>PoofExplosionCat3</DestroySound>
            <PCU>115</PCU>
            <PressurizeCube>true</PressurizeCube>
            <IsAirTight>true</IsAirTight>
			<DLC>Economy2</DLC>
        </Definition>

        <Definition xsi:type="MyObjectBuilder_DoorDefinition">
            <Id>
                <TypeId>Door</TypeId>
                <SubtypeId>SmallBlockAngledDoorA</SubtypeId>
